{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-S",
                ".",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DBUILD_TESTS=OFF"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "rm -f ${workspaceFolder}/build/alias_cd.far-plug-wide && cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Configure"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure"
            ],
            "group": "test",
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": [],
            "detail": "Run all tests via CTest"
        },
        {
            "label": "Release: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build-release",
                "-S",
                ".",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTS=OFF"
            ],
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Release: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-release",
                "--config",
                "Release"
            ],
            "group": "none",
            "dependsOn": [
                "Release: Configure"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Release: Package",
            "type": "shell",
            "command": "tar",
            "args": [
                "-czf",
                "${workspaceFolder}/alias_cd-plugin-release.tar.gz",
                "-C",
                "${workspaceFolder}/build-release",
                "alias_cd.far-plug-wide"
            ],
            "group": "none",
            "dependsOn": [
                "Release: Build"
            ],
            "problemMatcher": []
        },
        // Главная задача – просто запустите её, и она выполнит всё
        {
            "label": "Release: Build and Package",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Release: Package"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build, Copy & Run far2l",
            "type": "shell",
            "command": "rm -f ${workspaceFolder}/build/alias_cd.far-plug-wide && cmake --build build && cp ${workspaceFolder}/build/alias_cd.far-plug-wide /home/dima/far2l-dev/install/lib/far2l/Plugins/alias_cd/plug/ && LD_LIBRARY_PATH=/home/dima/far2l-dev/install/lib/far2l /home/dima/far2l-dev/install/bin/far2l",
            "group": "none",
            "dependsOn": [
                "CMake: Configure"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
