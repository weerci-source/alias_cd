{
    "version": "0.2.0",
    "configurations": [
        // Конфигурация для отладки плагина FAR (если нужно)
        {
            "name": "Debug FAR Plugin",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build",
            "program": "${workspaceFolder}/build/alias_cd.far-plug-wide",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        // Конфигурация для тестов (один конкретный тест, например test_logger)
        {
            "name": "Debug Logger Tests",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build",
            "program": "${workspaceFolder}/build/test_logger",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        // Конфигурация для запуска всех тестов сразу (test_all)
        {
            "name": "Debug All Tests",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build",
            "program": "${workspaceFolder}/build/test_all",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}